BMC_PARTNER_KEY=replace-with-your-primary-or-secondary-subscription-key
PORT=3000
# Browser-side settings; currently configured in config.js, not read by the cache server.
RT_VEHICLE_API_URL=https://your-cache-server/api/vehicles
RT_ALERT_API_URL=https://your-cache-server/api/alerts/raw
RT_UPDATE_API_URL=https://your-cache-server/api/delays
RT_REFRESH_RATE=30000
VERBOSE_LOGGING=false
